# Kitchen Table — Waymaker API Key
# Copy this file to .env and add your Anthropic API key
# Never commit .env to version control

ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs — Monday Brief audio generation
# Get from elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Voice ID from elevenlabs.io/app/voice-lab (click your saved voice)
ELEVENLABS_VOICE_ID=your-voice-id-here
